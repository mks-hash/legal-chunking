{
  "version": 1,
  "defaults": {
    "code": "statute",
    "primary_legislation": "statute",
    "secondary_legislation": "statute",
    "court_guidance": "guidance",
    "guidance": "guidance",
    "case_law": "case_law",
    "commentary": "guidance",
    "other": "default",
    "constitutional_norm": "statute",
    "constitutional_legislation": "statute",
    "regulatory_instrument": "statute",
    "procedure_rules": "statute",
    "treaty": "statute",
    "constitutional_court_decision": "case_law",
    "administrative_decision": "case_law",
    "standard": "guidance",
    "expert_opinion": "guidance"
  },
  "fallback": {
    "max_chars": 1200,
    "overlap_chars": 120
  },
  "runtime": {
    "pdf": {
      "drop_line_equals": [
        "EN"
      ],
      "drop_line_regexes": [
        "^[CL]\\s+\\d+/\\d+$",
        "^\\(\\d+\\)\\s+OJ\\s+[CL]\\s+\\d+"
      ],
      "merge_wrapped_headings": true
    },
    "chunk": {
      "document_root_splitter": "eu_recitals",
      "article_splitter": "numbered_subdivisions",
      "article_subdivision_regex": "(?:(?<=^)|(?<=[.!?;:\\n]))\\s*(?P<label>(?:\\d+\\.|\\((?:[a-z]|\\d+)\\)))\\s+",
      "preferred_primary_units": [
        "article",
        "section"
      ]
    },
    "heading": {
      "block_signature_names": true
    }
  }
}
