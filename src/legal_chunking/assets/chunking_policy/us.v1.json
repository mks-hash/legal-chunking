{
  "version": 1,
  "defaults": {
    "code": "statute",
    "primary_legislation": "statute",
    "secondary_legislation": "statute",
    "procedure_rules": "statute",
    "guidance": "guidance",
    "case_law": "case_law",
    "commentary": "guidance",
    "other": "default",
    "constitutional_norm": "statute",
    "constitutional_legislation": "statute",
    "regulatory_instrument": "statute",
    "treaty": "statute",
    "constitutional_court_decision": "case_law",
    "administrative_decision": "case_law",
    "standard": "guidance",
    "expert_opinion": "guidance"
  },
  "fallback": {
    "max_chars": 1200,
    "overlap_chars": 120
  },
  "runtime": {
    "pdf": {
      "trim_rules_body": true,
      "trim_running_rule_headers": true,
      "merge_wrapped_headings": true
    },
    "chunk": {
      "article_splitter": "numbered_subdivisions",
      "article_subdivision_regex": "(?:(?<=^)|(?<=[.!?;:\\n]))\\s*(?P<label>\\((?:[a-z]|\\d+|[A-Z])\\))\\s+",
      "preferred_primary_units": [
        "article",
        "section"
      ]
    },
    "heading": {
      "allow_long_rule_titles": true
    }
  }
}
